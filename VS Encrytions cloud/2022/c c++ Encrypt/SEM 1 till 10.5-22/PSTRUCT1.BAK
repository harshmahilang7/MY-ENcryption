#include<stdio.h>
#include<conio.h>
#include<string.h>

struct employee
{
 int id;
 char name[20];
 float sal;
 char phone[15];
 char add[20];
}emp;
void main()
{
 clrscr();
 printf("Enter the Address:");
 gets(emp.add);
 printf("enter the Employee id:");
 scanf("%d",&emp.id);
