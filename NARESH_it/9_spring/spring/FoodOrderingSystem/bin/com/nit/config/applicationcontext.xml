<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">
          
          
          <bean id="s1" class="com.nit.sbeans.ZomatoService">
          <property name="item" value="icecreme"></property>
          <property name="price" value="200"></property>
          </bean>
          
          <bean id="c1" class="com.nit.sbeans.FoodContext">
          <constructor-arg name="Fs" ref="s1"></constructor-arg>
          </bean> 
           
</beans>