/*Program 03:
----------
Write a program in Java to display the following pattern on the screen without using loop.
@@@@@@@@
@      @
@      @
@      @
@      @
@      @
@@@@@@@@
*/
class p_8 
{
	public static void main(String[] args) 
	{
		System.out.println("@@@@@@@@");
System.out.println("@      @");
System.out.println("@      @");
System.out.println("@      @");
System.out.println("@      @");
System.out.println("@      @");
System.out.println("@@@@@@@@");
	}
}
